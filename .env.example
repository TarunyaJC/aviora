[TEMPLATE]
# ── Server ──────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# Frontend origin allowed by CORS
CLIENT_URL=http://localhost:5173

# ── Auth (required from Phase 5 onward) ─────────────────
# Generate real values with: openssl rand -hex 32
JWT_SECRET=change-me-change-me-change-me-change-me
JWT_REFRESH_SECRET=change-me-change-me-change-me-change

# ── Database (SQLite via built-in node:sqlite) ──────────
# Defaults to <repo>/server/data/aviora.db — override either variable:
# AVIORA_DB_PATH=C:/absolute/path/aviora.db
# AVIORA_DATA_DIR=C:/absolute/path/data-dir
